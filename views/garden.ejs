<!DOCTYPE html>
<html>
<head>
    <title>Moonlit Garden</title>

    <style>
        body {
            margin: 0;
            background: #131a2c;
            overflow: hidden;
        }

        /* background */
        #gardenCanvas {
            position: absolute;
            top: 0;
            left: 0;
        }

        /* add wish button */
        #addBtn {
            position: absolute;
            z-index: 10;
            top: 20px;
            right: 20px;
        }

        /* popup drawing panel */
        #modal {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(0,0,0,0.9);
            padding: 20px;
            border-radius: 10px;
            z-index: 100;
        }

       #drawCanvas {
            background: transparent;
            border-radius: 20px;
        }

        #wishPopup {
            display: none;
            position: absolute;
            background: rgba(20, 20, 30, 0.95);
            color: white;
            padding: 12px 14px;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.5);
            border: 1px solid rgba(255,255,255,0.2);
            max-width: 200px;
            z-index: 999;
        }
        
        #closeWishPopup {
            position: absolute;
            top: 6px;
            right: 6px;

            border: none;
            background: transparent;
            color: white;

            cursor: pointer;
            font-size: 14px;
        }
        
        /* wish message */
        #wishText {
            color: white;
            font-style: italic;
            font-size: 16px;
            margin-bottom: 10px;
        }

        /* author */
        #wishAuthor {
            margin-top: 10px;
            text-align: center;
            font-size: 12px;
            opacity: 0.8;
        }

    </style>
</head>

<body>

<button id="addBtn">+ Add Wish</button>
<canvas id="gardenCanvas"></canvas>

<div id="modal">
    <!-- popup drawing panel -->
    <div id="drawingStep">
        <canvas id="drawCanvas" width="300" height="300"></canvas>
        <br>
        <!--create colour picker ui-->
        <input type="color" id="colorPicker" value="#ff69b4">
        <button id="eraseBtn">🧽 Erase</button>
        <button id="nextBtn">➡ Next</button>
        <button id="closeBtn">❌ Close</button>

    </div>

    <!--message/wish textbox-->
    <div id="wishStep" style="display:none;">

        <h3 style="color:white;">Make a Wish 🌙</h3>
        <input
            id="createdBy"
            placeholder="Your name (optional)"
        >
        <br><br>
        <textarea
            id="wishMessage"
            rows="5"
            cols="30"
            placeholder="Write your wish..."
        ></textarea>
        <br><br>
        <button id="plantBtn">
            🌸 Plant Wish
        </button>

    </div>

</div>

<!-- wish textbox -->
<div id="wishPopup"
    <div id="wishBox">
        <button id="closeWishPopup">✖</button>
        <p id="wishText"></p>
        <p id="wishAuthor"></p>
    </div>
</div>

<script src="/garden.js"></script>

</body>
</html>